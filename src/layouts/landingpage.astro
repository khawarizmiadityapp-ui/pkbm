---
import '../styles/global.css';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

interface Props {
  title?: string;
}

const { title = "PKBM - Lorem ipsum dolor sit amet" } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0f172a] text-slate-100 min-h-screen flex flex-col antialiased selection:bg-amber-400 selection:text-slate-900">
    <!-- Navbar / Header -->
    <Header />

    <!-- Konten Halaman (Index atau halaman lainnya) -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
