---
import LandingLayout from '../layouts/landingpage.astro';
---

<LandingLayout title="PKBM INTAN - Sekolah Kesetaraan Resmi & Terakreditasi A">
  <section class="max-w-6xl mx-auto px-6 py-24 text-center">
    <div class="inline-flex items-center gap-2 bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs md:text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      Penerimaan Warga Belajar Baru Telah Dibuka
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
      Raih Masa Depan Lebih Cerah Bersama <br />
      <span class="text-amber-400">PKBM INTAN</span>
    </h1>

    <p class="mt-6 text-base md:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Sekolah kesetaraan resmi dan terakreditasi A. Layanan pendidikan Paket A, Paket B, dan Paket C yang fleksibel, bermutu, dan diakui negara.
    </p>

    <!-- Tombol CTA -->
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/program"
        class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold px-8 py-3.5 rounded-full transition shadow-lg shadow-amber-500/20"
      >
        Lihat Program Belajar
      </a>
      <a
        href="/kontak"
        class="border border-slate-700 hover:border-slate-500 bg-slate-800/60 hover:bg-slate-800 text-white font-medium px-8 py-3.5 rounded-full transition"
      >
        Hubungi Kami
      </a>
    </div>
  </section>
</LandingLayout>
