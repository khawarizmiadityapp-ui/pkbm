---
import PageProgramLayout from '../layouts/pageprogram.astro';
import KesetaraanA from '../components/program/kesetaraanA.astro';
---

<PageProgramLayout
  title="Kesetaraan Paket A"
  currentPage="Kesetaraan Paket A"
  description="Program Pendidikan Kesetaraan Paket A, Paket B, dan Paket C di PKBM."
>
  <KesetaraanA />
</PageProgramLayout>

<script>
  const hash = window.location.hash.toLowerCase();
  if (hash === '#paket-b') {
    window.location.replace('/program/paket-b');
  } else if (hash === '#paket-c') {
    window.location.replace('/program/paket-c');
  }
</script>
