---
import { AGENDA_CATEGORY_BADGES, type AgendaItem } from '../../data/agendas';

interface Props {
  agenda: AgendaItem;
  eager?: boolean;
}

const { agenda, eager = false } = Astro.props;
const categoryBadgeClass = AGENDA_CATEGORY_BADGES[agenda.category];
const isCompleted = agenda.status === 'completed';
const badgeText = agenda.badgeLabel ?? agenda.category;
---

<article
  id={agenda.slug}
  data-agenda-card
  data-category={agenda.category}
  class="group bg-white border border-[#E2E8F0] rounded-xl overflow-hidden shadow-[0_2px_10px_rgba(15,37,55,0.04)] hover:shadow-[0_10px_24px_rgba(15,37,55,0.09)] hover:-translate-y-0.5 transition-all duration-200 flex flex-col h-full"
>
  <div class="relative aspect-[4/5] bg-[#0B2239] overflow-hidden shrink-0">
    <img
      src={agenda.poster}
      alt={agenda.posterAlt}
      width="640"
      height="800"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />

    {agenda.isFree && (
      <div
        class="absolute top-3 -left-8 w-28 -rotate-45 bg-[#EF4444] text-white text-[10px] font-extrabold uppercase tracking-wider text-center py-1 shadow-sm pointer-events-none"
        aria-hidden="true"
      >
        FREE
      </div>
    )}

    {isCompleted && (
      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-[#475569]/85 backdrop-blur-[2px] text-white text-[11px] font-semibold leading-none shadow-xs pointer-events-none">
        Selesai
      </span>
    )}
  </div>

  <div class="p-5 flex flex-col flex-1">
    <div>
      <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider leading-none ${categoryBadgeClass}`}>
        {badgeText}
      </span>
    </div>

    <h2 class="mt-3 text-[15px] sm:text-base font-bold text-[#0F2537] leading-snug group-hover:text-[#0284C7] transition-colors line-clamp-2">
      {agenda.title}
    </h2>

    <div class="mt-3.5 space-y-2 text-xs text-[#64748B]">
      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#E9A820] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class="truncate">{agenda.dateLabel} &bull; {agenda.timeLabel}</span>
      </div>

      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#10B981] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M3.6 9h16.8" />
          <path d="M3.6 15h16.8" />
          <path d="M11.5 3a17 17 0 0 0 0 18" />
          <path d="M12.5 3a17 17 0 0 1 0 18" />
        </svg>
        <span class="truncate font-medium text-[#10B981]">{agenda.modeLabel}</span>
      </div>

      <div class="flex items-start gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#F43F5E] shrink-0 mt-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span class="line-clamp-2 leading-relaxed">{agenda.location}</span>
      </div>
    </div>

    <div class="mt-auto pt-3.5 mt-4 border-t border-[#F1F5F9] flex items-center justify-between gap-3 text-xs">
      <span class="text-[11px] text-[#94A3B8] truncate">
        {agenda.statusNote}
      </span>

      <button
        type="button"
        data-agenda-open={agenda.id}
        aria-label={`Lihat detail agenda: ${agenda.title}`}
        class="inline-flex items-center gap-1 font-semibold text-[#0284C7] hover:text-[#0369A1] transition-colors shrink-0 cursor-pointer focus:outline-none focus-visible:underline"
      >
        <span>{agenda.actionLabel}</span>
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>
  </div>
</article>
