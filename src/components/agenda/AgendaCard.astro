---
import { AGENDA_CATEGORY_BADGES, type AgendaItem } from '../../data/agendas';

interface Props {
  agenda: AgendaItem;
  eager?: boolean;
}

const { agenda, eager = false } = Astro.props;
const categoryBadgeClass = AGENDA_CATEGORY_BADGES[agenda.category];
const isCompleted = agenda.status === 'completed';
---

<article
  id={agenda.slug}
  data-agenda-card
  data-category={agenda.category}
  class="group bg-white border border-[#DCE3EA] rounded-xl overflow-hidden shadow-[0_2px_10px_rgba(16,47,77,0.05)] hover:shadow-[0_10px_24px_rgba(16,47,77,0.10)] hover:-translate-y-0.5 transition-all duration-200 flex flex-col h-full"
>
  <!-- 4:5 Poster Thumbnail -->
  <div class="relative aspect-[4/5] bg-[#091E32] overflow-hidden shrink-0">
    <img
      src={agenda.poster}
      alt={agenda.posterAlt}
      width="640"
      height="800"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />

    {isCompleted && (
      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-[#475569]/85 backdrop-blur-[2px] text-white text-[11px] font-semibold leading-none shadow-sm pointer-events-none">
        Selesai
      </span>
    )}
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-semibold leading-none ${categoryBadgeClass}`}>
        {agenda.category}
      </span>

      {isCompleted ? (
        <span class="text-[11px] font-medium text-[#687789]">
          Telah Terlaksana
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#A86D0A]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#E9A820]" aria-hidden="true"></span>
          <span>Akan Datang</span>
        </span>
      )}
    </div>

    <h2 class="text-[17px] font-bold text-[#102F4D] leading-snug group-hover:text-[#153A5B] transition-colors line-clamp-2">
      {agenda.title}
    </h2>

    <p class="mt-2 mb-5 text-sm text-[#687789] leading-relaxed line-clamp-2">
      {agenda.description}
    </p>

    <!-- Schedule Metadata & Action -->
    <div class="mt-auto pt-4 border-t border-[#EDF1F5] space-y-2 text-xs text-[#687789]">
      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#102F4D]/70 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class="truncate">{agenda.dateLabel} &bull; {agenda.timeLabel}</span>
      </div>

      <div class="flex items-center justify-between gap-3 pt-0.5">
        <div class="flex items-center gap-2 min-w-0">
          <svg
            class="w-3.5 h-3.5 text-[#102F4D]/70 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span class="truncate">{agenda.location}</span>
        </div>

        <button
          type="button"
          data-agenda-open={agenda.id}
          aria-label={`Lihat detail agenda: ${agenda.title}`}
          class="inline-flex items-center gap-1 font-semibold text-[#102F4D] hover:text-[#B87A0E] transition-colors shrink-0 cursor-pointer focus:outline-none focus-visible:underline"
        >
          <span>Detail Agenda</span>
          <svg
            class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</article>
