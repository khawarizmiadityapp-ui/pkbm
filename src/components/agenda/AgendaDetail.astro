---
import { AGENDA_CATEGORY_BADGES, type AgendaItem } from '../../data/agendas';
import BottomCtaBanner from '../common/BottomCtaBanner.astro';
import EventMetaList from '../common/EventMetaList.astro';

interface Props {
  agenda: AgendaItem;
}

const { agenda } = Astro.props;
const categoryBadgeClass = AGENDA_CATEGORY_BADGES[agenda.category];
const badgeText = agenda.badgeLabel ?? agenda.category;
const posterSrc = agenda.detailPoster ?? agenda.poster;
const infoSchedule = agenda.infoScheduleLabel ?? `${agenda.dateLabel} • ${agenda.timeLabel}`;
const infoLocation = agenda.infoLocationLabel ?? `${agenda.modeLabel} , ${agenda.location}`;
const bodyParagraphs =
  agenda.paragraphs && agenda.paragraphs.length > 0
    ? agenda.paragraphs
    : [agenda.description];
---

<section class="bg-white py-10 md:py-14" aria-label={agenda.title}>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 lg:gap-8 items-start">
      <!-- Left Main Column (Two Stacked White Cards) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Card 1: Poster & Event Header -->
        <article class="bg-white rounded-xl border border-[#E6EAF0] shadow-[0_2px_12px_rgba(15,37,55,0.03)] overflow-hidden">
          <div class="w-full bg-[#324052] overflow-hidden">
            <img
              src={posterSrc}
              alt={agenda.posterAlt}
              width="800"
              height="520"
              loading="eager"
              decoding="async"
              class="w-full h-auto block object-cover"
            />
          </div>

          <div class="p-6 sm:p-8">
            <div>
              <span
                class:list={[
                  'inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider leading-none',
                  categoryBadgeClass,
                ]}
              >
                {badgeText}
              </span>
            </div>

            <h2 class="mt-3.5 text-lg sm:text-xl font-bold text-[#0F2537] tracking-tight leading-snug">
              {agenda.title}
            </h2>

            <EventMetaList
              dateLabel={agenda.dateLabel}
              timeLabel={agenda.timeLabel}
              modeLabel={agenda.modeLabel}
              location={agenda.location}
              class="mt-3.5"
            />
          </div>
        </article>

        <!-- Card 2: Agenda Description Body -->
        <div class="bg-white rounded-xl border border-[#E6EAF0] shadow-[0_2px_12px_rgba(15,37,55,0.03)] p-6 sm:p-8 lg:p-10 min-h-[260px]">
          <div class="space-y-2 text-xs sm:text-[13px] text-[#687789] leading-relaxed">
            {bodyParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-[#0B192C] rounded-xl p-6 text-white shadow-sm">
          <h3 class="text-sm sm:text-base font-bold text-[#E9A820]">
            Info Acara
          </h3>

          <ul class="mt-4 space-y-3.5 text-xs text-slate-200 leading-relaxed">
            <li class="flex items-start gap-3">
              <svg
                class="w-4 h-4 text-[#E9A820] shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <polyline points="12 7 12 12 15 14" />
              </svg>
              <span>{infoSchedule}</span>
            </li>

            <li class="flex items-start gap-3">
              <svg
                class="w-4 h-4 text-[#E9A820] shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
              </svg>
              <span>{infoLocation}</span>
            </li>
          </ul>

          <a
            href="/kontak"
            class="mt-6 w-full inline-flex items-center justify-center bg-[#DDA027] hover:bg-[#c88d19] text-[#0B192C] font-bold text-xs py-2.5 px-4 rounded-lg transition-colors"
          >
            <span>Daftar Sekarang</span>
          </a>
        </div>
      </aside>
    </div>

    <!-- Bottom CTA Banner -->
    <BottomCtaBanner />
  </div>
</section>
