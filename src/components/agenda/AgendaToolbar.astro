---
import { AGENDA_FILTERS } from '../../data/agendas';
---

<div
  role="group"
  aria-label="Filter kategori agenda"
  class="flex flex-wrap items-center gap-2 mb-7"
>
  {AGENDA_FILTERS.map((filter, index) => {
    const isDefaultActive = index === 0;
    const activeClasses = 'bg-[#0B2239] text-white border-[#0B2239] font-semibold shadow-2xs';
    const inactiveClasses =
      'bg-white hover:bg-slate-50 text-[#334155] border-[#DCE3EA] font-medium';

    return (
      <button
        type="button"
        data-agenda-filter={filter.value}
        data-active-class={activeClasses}
        data-inactive-class={inactiveClasses}
        aria-pressed={isDefaultActive ? 'true' : 'false'}
        class:list={[
          'h-9 px-4 rounded-md border text-xs sm:text-[13px] transition-colors cursor-pointer whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2239]',
          isDefaultActive ? activeClasses : inactiveClasses,
        ]}
      >
        {filter.label}
      </button>
    );
  })}
</div>
