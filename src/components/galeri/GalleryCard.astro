---
import type { GalleryMockupItem } from '../../data/gallery';

interface Props {
  item: GalleryMockupItem;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
const isPhoto = item.type === 'photo';
const isVideo = item.type === 'video';
---

<article
  class:list={[
    'group relative bg-white rounded-2xl border border-[#EAECEF] shadow-[0_2px_12px_rgba(15,37,55,0.04)] hover:shadow-[0_12px_28px_rgba(15,37,55,0.10)] hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col h-full',
    isPhoto && 'cursor-pointer',
  ]}
>
  {isPhoto && item.href && (
    <a
      href={item.href}
      aria-label={`Lihat album ${item.title}`}
      class="absolute inset-0 z-20 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E9A820]"
    ></a>
  )}
  <div class="relative aspect-[16/10] bg-slate-100 overflow-hidden shrink-0">
    <img
      src={item.thumbnail}
      alt={item.thumbnailAlt}
      width="720"
      height="450"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={[
        'w-full h-full object-cover transition-transform duration-500 ease-out',
        isPhoto && 'group-hover:scale-105',
      ]}
    />

    {isPhoto && (
      <div
        class="absolute inset-0 bg-[#102336]/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center text-white pointer-events-none"
        aria-hidden="true"
      >
        <div class="flex flex-col items-center transform translate-y-2 scale-95 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-300 ease-out">
          <!-- Open Folder / Album Icon matching screenshot -->
          <svg
            class="w-11 h-11 text-white drop-shadow-sm"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M20 6h-8l-2-2H4C2.9 4 2 4.9 2 6v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-16 2h15v1.5H5.8c-.75 0-1.41.48-1.65 1.19L4 11.2V8zm16 10H4.5l1.65-5.5H20V18z" />
          </svg>
          <span class="mt-1.5 text-sm font-bold text-white tracking-wide drop-shadow-xs">
            Lihat Album
          </span>
        </div>

        {item.photoCount && (
          <span class="absolute bottom-3 left-3 px-3 py-1 rounded-full bg-[#0D1E2E]/85 text-white text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm transform translate-y-1 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
            <span>{item.photoCount}</span>
          </span>
        )}
      </div>
    )}

    {isVideo && (
      <div class="absolute inset-0 bg-[#091E32]/25 flex items-center justify-center">
        <span
          class="w-12 h-12 rounded-full bg-[#EE0000] text-white shadow-lg flex items-center justify-center transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true"
        >
          <svg class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>

        {item.duration && (
          <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded bg-[#091E32]/80 text-white text-[10px] font-semibold tracking-wide">
            {item.duration}
          </span>
        )}
      </div>
    )}
  </div>

  <div class="p-6 pb-8 flex flex-col flex-1 items-start">
    <span class="inline-flex items-center px-3.5 py-1 rounded-md text-[11px] font-semibold bg-[#FFFDF5] border border-[#FDE68A] text-[#C27803]">
      {item.badge}
    </span>

    <h2 class="mt-3.5 text-lg font-extrabold text-[#0F2537] tracking-tight">
      {item.title}
    </h2>

    <p class="mt-2 text-xs sm:text-[13.5px] text-[#687789] leading-relaxed">
      {item.description}
    </p>

    {isVideo && (
      <a
        href="#tonton-youtube"
        class="mt-auto pt-5 inline-flex items-center gap-2 text-xs sm:text-[13px] font-bold text-[#DC2626] hover:text-[#B91C1C] transition-colors"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
        </svg>
        <span>Tonton di YouTube</span>
      </a>
    )}
  </div>
</article>
