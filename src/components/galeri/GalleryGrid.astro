---
import type { GalleryMockupItem } from '../../data/gallery';
import GalleryCard from './GalleryCard.astro';

interface Props {
  items: GalleryMockupItem[];
  ariaLabel?: string;
}

const { items, ariaLabel = 'Daftar Galeri' } = Astro.props;
---

<section class="bg-white py-12 md:py-16 lg:py-20 min-h-[540px]" aria-label={ariaLabel}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 lg:gap-8">
      {items.map((item, index) => (
        <GalleryCard item={item} eager={index < 3} />
      ))}
    </div>
  </div>
</section>
