---
import { CONTACT_LINKS } from '../../data/contact';
---

<section aria-label="Peta Lokasi Kota Bandung" class="w-full border-t border-[#DCE3EA] bg-[#E3ECF1]">
  <div class="relative w-full h-[340px] sm:h-[400px] lg:h-[430px]">
    <iframe
      title="Peta Lokasi Kota Bandung, Jawa Barat"
      src={CONTACT_LINKS.mapEmbedSrc}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="w-full h-full border-0 block"
      allowfullscreen
    ></iframe>
  </div>
</section>
