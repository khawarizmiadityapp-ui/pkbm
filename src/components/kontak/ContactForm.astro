---
---

<div class="bg-white border border-[#DCE3EA] rounded-xl p-6 sm:p-8 shadow-[0_2px_12px_rgba(16,47,77,0.05)]">
  <h2 class="text-xl sm:text-2xl font-bold text-[#102F4D] tracking-tight mb-6">
    Kirim Pesan
  </h2>

  <div
    id="contact-form-feedback"
    role="status"
    aria-live="polite"
    class="hidden mb-6 rounded-lg border border-[#20C968]/35 bg-[#ECFDF3] px-4 py-3 text-sm text-[#0F5132]"
  >
    <div class="flex items-start justify-between gap-3">
      <p>
        Terima kasih! Pesan berhasil disimulasikan pada mockup UI statis ini (belum terhubung ke server/API).
      </p>
      <button
        id="contact-feedback-close"
        type="button"
        aria-label="Tutup notifikasi"
        class="text-[#0F5132]/70 hover:text-[#0F5132] font-bold text-xs cursor-pointer shrink-0"
      >
        Tutup
      </button>
    </div>
  </div>

  <div
    id="contact-form-error"
    role="alert"
    aria-live="polite"
    class="hidden mb-6 rounded-lg border border-[#FCA5A5] bg-[#FEF2F2] px-4 py-3 text-sm text-[#991B1B]"
  >
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-start gap-2.5">
        <svg class="w-4 h-4 shrink-0 mt-0.5 text-[#DC2626]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <p id="contact-form-error-text">
          Mohon lengkapi kolom wajib yang ditandai * terlebih dahulu.
        </p>
      </div>
      <button
        id="contact-error-close"
        type="button"
        aria-label="Tutup peringatan"
        class="text-[#991B1B]/70 hover:text-[#991B1B] font-bold text-xs cursor-pointer shrink-0"
      >
        Tutup
      </button>
    </div>
  </div>

  <form id="contact-mockup-form" novalidate class="space-y-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-name" class="block text-sm font-semibold text-[#102F4D] mb-2">
          Nama Lengkap <span class="text-[#C84B17]" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          placeholder="Nama Lengkap"
          class="w-full h-11 rounded-lg bg-white border border-[#DCE3EA] px-3.5 text-sm text-[#102F4D] placeholder:text-[#687789]/80 focus:outline-none focus:border-[#102F4D] focus:ring-2 focus:ring-[#102F4D]/10 transition-colors"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-sm font-semibold text-[#102F4D] mb-2">
          Email <span class="text-[#C84B17]" aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          placeholder="email@contoh.com"
          class="w-full h-11 rounded-lg bg-white border border-[#DCE3EA] px-3.5 text-sm text-[#102F4D] placeholder:text-[#687789]/80 focus:outline-none focus:border-[#102F4D] focus:ring-2 focus:ring-[#102F4D]/10 transition-colors"
        />
      </div>

      <div>
        <label for="contact-phone" class="block text-sm font-semibold text-[#102F4D] mb-2">
          Nomor HP
        </label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          placeholder="08xxxxxxxxxx"
          class="w-full h-11 rounded-lg bg-white border border-[#DCE3EA] px-3.5 text-sm text-[#102F4D] placeholder:text-[#687789]/80 focus:outline-none focus:border-[#102F4D] focus:ring-2 focus:ring-[#102F4D]/10 transition-colors"
        />
      </div>

      <div>
        <label for="contact-subject" class="block text-sm font-semibold text-[#102F4D] mb-2">
          Subjek
        </label>
        <input
          id="contact-subject"
          name="subject"
          type="text"
          placeholder="Informasi Pendaftaran"
          class="w-full h-11 rounded-lg bg-white border border-[#DCE3EA] px-3.5 text-sm text-[#102F4D] placeholder:text-[#687789]/80 focus:outline-none focus:border-[#102F4D] focus:ring-2 focus:ring-[#102F4D]/10 transition-colors"
        />
      </div>
    </div>

    <div>
      <label for="contact-message" class="block text-sm font-semibold text-[#102F4D] mb-2">
        Pesan <span class="text-[#C84B17]" aria-hidden="true">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        placeholder="Tulis pesan Anda di sini..."
        class="w-full rounded-lg bg-white border border-[#DCE3EA] p-3.5 text-sm text-[#102F4D] placeholder:text-[#687789]/80 focus:outline-none focus:border-[#102F4D] focus:ring-2 focus:ring-[#102F4D]/10 transition-colors resize-y"
      ></textarea>
    </div>

    <div class="pt-1">
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-[#102F4D] hover:bg-[#153A5B] text-white font-semibold text-sm px-7 py-3 shadow-sm transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E9A820]"
      >
        <svg width="16" height="16" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z" />
        </svg>
        <span>Kirim Pesan</span>
      </button>
    </div>
  </form>
</div>

<script>
  import { attachCustomFormValidation, clearAllFormErrors } from '../../scripts/formValidation';

  const form = document.getElementById('contact-mockup-form') as HTMLFormElement | null;
  const feedback = document.getElementById('contact-form-feedback');
  const closeFeedback = document.getElementById('contact-feedback-close');
  const errorBox = document.getElementById('contact-form-error');
  const errorText = document.getElementById('contact-form-error-text');
  const closeError = document.getElementById('contact-error-close');

  attachCustomFormValidation(form, {
    summaryBox: errorBox,
    summaryTextEl: errorText,
    onValidSubmit: (validForm) => {
      clearAllFormErrors(validForm, errorBox);
      feedback?.classList.remove('hidden');
      validForm.reset();
    },
  });

  closeFeedback?.addEventListener('click', () => {
    feedback?.classList.add('hidden');
  });

  closeError?.addEventListener('click', () => {
    errorBox?.classList.add('hidden');
  });
</script>
