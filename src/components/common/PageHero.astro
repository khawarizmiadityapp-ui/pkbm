---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  currentPage: string;
  parentPage?: BreadcrumbItem;
}

const { title, currentPage, parentPage } = Astro.props;
---

<section class="bg-gradient-to-b from-[#091E32] to-[#0D253E] border-b-2 border-[#E9A820]">
  <div class="max-w-[1528px] mx-auto px-4 sm:px-6 lg:px-10 py-11 sm:py-14 lg:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
      {title}
    </h1>

    <nav aria-label="Breadcrumb" class="mt-2.5 flex items-center flex-wrap text-sm">
      <a
        href="/"
        class="text-slate-300 hover:text-white transition-colors"
      >
        Beranda
      </a>
      {parentPage && (
        <>
          <span class="mx-2 text-slate-400" aria-hidden="true">/</span>
          {parentPage.href ? (
            <a
              href={parentPage.href}
              class="text-slate-300 hover:text-white transition-colors"
            >
              {parentPage.label}
            </a>
          ) : (
            <span class="text-slate-300">{parentPage.label}</span>
          )}
        </>
      )}
      <span class="mx-2 text-slate-400" aria-hidden="true">/</span>
      <span aria-current="page" class="text-[#E9A820] font-medium">
        {currentPage}
      </span>
    </nav>
  </div>
</section>

