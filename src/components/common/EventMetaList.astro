---
interface Props {
  dateLabel?: string;
  timeLabel?: string;
  modeLabel?: string;
  location?: string;
  compact?: boolean;
  class?: string;
}

const {
  dateLabel,
  timeLabel,
  modeLabel,
  location,
  compact = false,
  class: className = '',
} = Astro.props;

const dateDisplay = [dateLabel, timeLabel].filter(Boolean).join(' • ');
---

{(dateDisplay || modeLabel || location) && (
  <div class:list={['space-y-2 text-xs text-[#64748B]', className]}>
    {dateDisplay && (
      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#E9A820] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class={compact ? 'truncate' : undefined}>{dateDisplay}</span>
      </div>
    )}

    {modeLabel && (
      <div class="flex items-center gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#10B981] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M3.6 9h16.8" />
          <path d="M3.6 15h16.8" />
          <path d="M11.5 3a17 17 0 0 0 0 18" />
          <path d="M12.5 3a17 17 0 0 1 0 18" />
        </svg>
        <span class:list={['font-medium text-[#10B981]', compact && 'truncate']}>{modeLabel}</span>
      </div>
    )}

    {location && (
      <div class="flex items-start gap-2 min-w-0">
        <svg
          class="w-3.5 h-3.5 text-[#F43F5E] shrink-0 mt-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <span class:list={['leading-relaxed', compact && 'line-clamp-2']}>{location}</span>
      </div>
    )}
  </div>
)}
