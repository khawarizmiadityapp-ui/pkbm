---
import { CATEGORY_BADGE_STYLES, type Article } from '../../data/articles';

interface Props {
  article: Article;
  eager?: boolean;
}

const { article, eager = false } = Astro.props;
const badgeClasses = CATEGORY_BADGE_STYLES[article.category];
---

<article
  id={article.slug}
  data-article-card
  data-category={article.category}
  data-search-text={`${article.title} ${article.description} ${article.category}`.toLowerCase()}
  class="group bg-white border border-[#DCE3EA] rounded-xl overflow-hidden shadow-[0_2px_10px_rgba(16,47,77,0.05)] hover:shadow-[0_10px_24px_rgba(16,47,77,0.10)] hover:-translate-y-0.5 transition-all duration-200 flex flex-col h-full"
>
  <div class="relative aspect-video bg-[#091E32] overflow-hidden shrink-0">
    <img
      src={article.thumbnail}
      alt={article.thumbnailAlt}
      width="800"
      height="450"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />

    <div class="absolute top-2.5 left-2.5 flex flex-col items-start gap-1 pointer-events-none">
      <span
        class={`px-2 py-1 rounded text-[10.5px] font-bold uppercase tracking-wider leading-none shadow-sm ${badgeClasses}`}
      >
        {article.category}
      </span>

      <div class="bg-white rounded-md px-2 py-1 text-center shadow-sm border border-[#DCE3EA]/80 min-w-[40px]">
        <span class="block text-sm font-bold text-[#102F4D] leading-none">
          {article.day}
        </span>
        <span class="block text-[9.5px] font-bold uppercase tracking-wider text-[#687789] mt-0.5 leading-none">
          {article.month}
        </span>
      </div>
    </div>
  </div>

  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <h2 class="text-[17px] font-bold text-[#102F4D] leading-snug group-hover:text-[#153A5B] transition-colors line-clamp-3">
      <a
        href={`/blog/${article.slug}`}
        class="focus:outline-none focus-visible:underline"
      >
        {article.title}
      </a>
    </h2>

    <p class="mt-2.5 mb-5 text-sm text-[#687789] leading-relaxed line-clamp-3">
      {article.description}
    </p>

    <div class="mt-auto pt-4 border-t border-[#EDF1F5] flex items-center justify-between gap-3 text-xs">
      <div class="inline-flex items-center gap-1.5 text-[#687789] min-w-0 truncate">
        <svg
          class="w-3.5 h-3.5 text-[#687789] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span class="truncate">
          {article.publishedAt ?? `${article.day} ${article.month} 2026`} &bull; {article.author ?? 'Admin PKBM'}
        </span>
      </div>

      <a
        href={`/blog/${article.slug}`}
        aria-label={`Baca selengkapnya: ${article.title}`}
        class="inline-flex items-center gap-1 font-semibold text-[#102F4D] hover:text-[#B87A0E] transition-colors shrink-0"
      >
        <span>Baca Selengkapnya</span>
        <svg
          class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </a>
    </div>
  </div>
</article>
