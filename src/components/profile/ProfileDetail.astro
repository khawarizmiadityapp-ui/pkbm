---
import { PROFILE_NAV_ITEMS, type ProfileMockupData } from '../../data/profile';

interface Props {
  profile: ProfileMockupData;
}

const { profile } = Astro.props;
---

<section class="bg-white py-10 md:py-14" aria-label={profile.title}>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 lg:gap-8 items-start">
      <!-- Left Main Content Card -->
      <div class="lg:col-span-8 bg-white rounded-xl border border-[#E6EAF0] shadow-[0_2px_12px_rgba(15,37,55,0.03)] p-7 sm:p-10 lg:p-12 min-h-[560px] flex flex-col">
        {profile.sections.map((section, idx) => (
          <div class:list={[idx > 0 && 'mt-auto pt-24 pb-8']}>
            <h2 class="text-lg sm:text-xl font-extrabold text-[#0F2537] tracking-tight">
              {section.heading}
            </h2>

            {section.paragraphs && section.paragraphs.length > 0 && (
              <div class="mt-4 space-y-2 text-xs sm:text-[13px] text-slate-600 leading-relaxed">
                {section.paragraphs.map((text) => (
                  <p>{text}</p>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Right Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Hubungi Kami Card -->
        <div class="bg-[#0B192C] rounded-xl p-6 text-white shadow-sm">
          <h3 class="text-sm sm:text-base font-bold text-[#E9A820]">
            Hubungi Kami
          </h3>

          <ul class="mt-4 space-y-2.5 text-xs text-slate-200">
            <li class="flex items-center gap-2.5">
              <svg class="w-3.5 h-3.5 text-[#E9A820] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z" />
              </svg>
              <span>0857-2245-9994</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-3.5 h-3.5 text-[#E9A820] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
              <span>support@pkbm.id</span>
            </li>
          </ul>

          <a
            href="#chat-whatsapp"
            class="mt-5 w-full inline-flex items-center justify-center gap-2 bg-[#DDA027] hover:bg-[#c88d19] text-[#0B192C] font-bold text-xs py-2.5 px-4 rounded-lg transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>Chat WhatsApp</span>
          </a>
        </div>

        <!-- Profil Sekolah Navigation Card -->
        <div class="bg-white rounded-xl border border-[#E6EAF0] p-6 shadow-[0_2px_12px_rgba(15,37,55,0.03)]">
          <h3 class="text-xs font-extrabold text-[#0F2537] pb-3.5 border-b border-slate-100">
            Profil Sekolah
          </h3>

          <nav class="mt-3.5 space-y-1.5" aria-label="Navigasi Profil Sekolah">
            {PROFILE_NAV_ITEMS.map((item) => {
              const isActive = item.id === profile.id;
              return (
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-semibold transition-colors',
                    isActive
                      ? 'bg-[#0B192C] text-white shadow-2xs'
                      : 'text-[#334155] hover:bg-slate-50 hover:text-[#0F2537]',
                  ]}
                >
                  <span class:list={['shrink-0', isActive ? 'text-[#E9A820]' : 'text-[#0F2537]']} aria-hidden="true">
                    {item.icon === 'file' && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 7V3.5L19.5 8H15v1zm-7 4h8v1.5H8V13zm0 3.5h8V18H8v-1.5zm0-7h4V11H8V9.5z" />
                      </svg>
                    )}
                    {item.icon === 'target' && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9" />
                        <circle cx="12" cy="12" r="5" />
                        <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                      </svg>
                    )}
                    {item.icon === 'star' && (
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2.5l2.93 5.94 6.56.95-4.74 4.62 1.12 6.53L12 17.45l-5.87 3.09 1.12-6.53L2.51 9.39l6.56-.95L12 2.5z" />
                      </svg>
                    )}
                  </span>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
        </div>
      </aside>
    </div>

    <!-- Bottom CTA Banner -->
    <div class="mt-10 md:mt-12 bg-[#0B192C] rounded-2xl px-7 py-8 sm:px-10 sm:py-9 md:px-12 flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
      <div>
        <h2 class="text-xl sm:text-2xl md:text-[26px] font-extrabold text-white tracking-tight">
          Lorem ipsum dolor sit amet consectetur
        </h2>
        <p class="mt-1.5 text-xs sm:text-[13px] text-slate-400">
          Lorem ipsum dolor sit amet consectetur adipiscing elit sed
        </p>
      </div>

      <a
        href="#cta"
        class="shrink-0 bg-[#F59E0B] hover:bg-[#eab308] text-[#0B192C] font-bold text-xs px-6 py-3 rounded-full inline-flex items-center gap-2 transition-colors shadow-xs"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm1 14.93V13H8v-2h5V7.07L17.93 12 13 16.93z" />
        </svg>
        <span>Lorem ipsum</span>
      </a>
    </div>
  </div>
</section>
