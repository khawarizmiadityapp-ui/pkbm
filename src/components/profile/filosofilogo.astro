---
import ProfileDetail from './ProfileDetail.astro';
import { PROFILE_DATA } from '../../data/profile';

interface PhilosophyItem {
  number: string;
  badgeVariant: 'navy' | 'amber';
  icon: 'book' | 'lotus' | 'shield';
  title: string;
  description: string;
}

interface PhilosophyGroup {
  eyebrow: string;
  heading: string;
  headerIcon: 'layers' | 'tree';
  items: PhilosophyItem[];
}

const sharedItems: PhilosophyItem[] = [
  {
    number: '01',
    badgeVariant: 'navy',
    icon: 'book',
    title: 'Lorem Ipsum Dolor',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
  {
    number: '02',
    badgeVariant: 'amber',
    icon: 'lotus',
    title: 'Consectetur Adipiscing',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
  {
    number: '03',
    badgeVariant: 'navy',
    icon: 'shield',
    title: 'Eiusmod Tempor Incididunt',
    description:
      'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
  },
];

const philosophyGroups: PhilosophyGroup[] = [
  {
    eyebrow: 'LOREM 01',
    heading: 'Lorem Ipsum Dolor Sit Amet',
    headerIcon: 'layers',
    items: sharedItems,
  },
  {
    eyebrow: 'LOREM 01',
    heading: 'Lorem Ipsum Dolor Sit Amet',
    headerIcon: 'tree',
    items: sharedItems,
  },
];
---

<ProfileDetail profile={PROFILE_DATA['filosofi-logo']}>
  <div class="space-y-8">
    <!-- Top Brand Logo Showcase -->
    <div class="rounded-xl bg-[#F3F6FC] border border-[#E5EAF4] p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-5">
      <div class="w-20 h-20 rounded-xl bg-white border border-[#E8EDF5] shadow-xs flex items-center justify-center shrink-0">
        <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#FDE047] to-[#F59E0B] flex items-center justify-center text-[#0F2537] shadow-2xs">
          <svg
            class="w-7 h-7"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
            <path d="M22 10v6" />
            <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
          </svg>
        </div>
      </div>

      <div>
        <h2 class="text-lg sm:text-xl font-extrabold text-[#0F2537] tracking-tight leading-tight">
          PKBM
        </h2>
        <p class="mt-0.5 text-xs font-bold text-[#B4690E]">
          &ldquo;Insan Cinta Kependidikan&rdquo;
        </p>
        <p class="mt-2 text-[11.5px] sm:text-xs text-slate-600 leading-relaxed">
          Setiap garis, bentuk, dan warna pada logo PKBM INTAN dirancang untuk merepresentasikan semangat pelayanan pendidikan nonformal yang inklusif, profesional, dan berdaya saing.
        </p>
      </div>
    </div>

    <!-- Philosophy Groups -->
    {philosophyGroups.map((group) => (
      <div>
        <div class="flex items-center gap-3">
          <span
            class="w-8 h-8 rounded-lg bg-[#0B192C] text-white inline-flex items-center justify-center shrink-0"
            aria-hidden="true"
          >
            {group.headerIcon === 'layers' ? (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 2 8 14H4Z" />
                <path d="m8 11 4-7 4 7" />
              </svg>
            ) : (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="5" r="2" />
                <circle cx="6" cy="17" r="2" />
                <circle cx="18" cy="17" r="2" />
                <path d="M12 7v4m0 0-5 4m5-4 5 4" />
              </svg>
            )}
          </span>
          <div>
            <p class="text-[9.5px] font-bold uppercase tracking-wider text-[#B4690E]">
              {group.eyebrow}
            </p>
            <h3 class="text-sm sm:text-base font-extrabold text-[#0F2537] leading-snug">
              {group.heading}
            </h3>
          </div>
        </div>

        <div class="mt-4 space-y-3">
          {group.items.map((item) => (
            <div class="rounded-xl bg-[#F3F6FC] border border-[#E5EAF4] p-4 flex items-start gap-3.5">
              <div
                class="w-9 h-9 rounded-lg bg-white border border-[#E6EAF0] shadow-2xs flex items-center justify-center shrink-0"
                aria-hidden="true"
              >
                {item.icon === 'book' && (
                  <svg class="w-4 h-4 text-[#0F2537]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                )}
                {item.icon === 'lotus' && (
                  <svg class="w-4 h-4 text-[#B4690E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20c4.5 0 8-3 8-7.5 0-2.5-1.5-4.5-3.5-5.5C15.5 9.5 14 11 12 11S8.5 9.5 7.5 7C5.5 8 4 10 4 12.5 4 17 7.5 20 12 20Z" />
                    <path d="M12 11V4" />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg class="w-4 h-4 text-[#0F2537]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
              </div>

              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span
                    class:list={[
                      'inline-flex items-center justify-center text-[10px] font-bold px-2 py-0.5 rounded leading-none',
                      item.badgeVariant === 'amber'
                        ? 'bg-[#F59E0B] text-white'
                        : 'bg-[#0B192C] text-white',
                    ]}
                  >
                    {item.number}
                  </span>
                  <h4 class="text-xs sm:text-[13px] font-extrabold text-[#0F2537]">
                    {item.title}
                  </h4>
                </div>
                <p class="mt-1.5 text-[11.5px] sm:text-xs text-slate-600 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</ProfileDetail>
