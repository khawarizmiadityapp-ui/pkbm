---
import ProfileDetail from './ProfileDetail.astro';
import { PROFILE_DATA } from '../../data/profile';

const missions = [
  {
    number: '01',
    title: 'Pendidikan Kesetaraan Berkualitas',
    description:
      'Menyelenggarakan program pendidikan kesetaraan Paket A (setara SD), Paket B (setara SMP), dan Paket C (setara SMA) dengan kurikulum nasional yang adaptif dan bermutu.',
  },
  {
    number: '02',
    title: 'Sistem Pembelajaran Hybrid yang Fleksibel',
    description:
      'Menerapkan metode belajar tatap muka, daring, dan modul mandiri yang dirancang khusus agar warga belajar dari berbagai latar belakang tetap dapat menyelesaikan studi.',
  },
  {
    number: '03',
    title: 'Keterampilan Vokasi & Literasi Digital',
    description:
      'Membekali warga belajar dengan kecakapan hidup (life skills), pelatihan vokasi, kewirausahaan, serta literasi digital untuk meningkatkan kemandirian ekonomi.',
  },
  {
    number: '04',
    title: 'Tata Kelola Transparan & Terakreditasi A',
    description:
      'Menjaga tata kelola lembaga yang profesional, transparan, dan akuntabel sesuai standar mutu BAN-PDM guna mempertahankan kepercayaan masyarakat dan mitra.',
  },
];

const coreValues = [
  {
    icon: 'users',
    title: 'Inklusif',
    description:
      'Terbuka bagi seluruh lapisan masyarakat tanpa memandang usia, latar belakang sosial, maupun kondisi ekonomi.',
  },
  {
    icon: 'clock',
    title: 'Fleksibel',
    description:
      'Jadwal dan metode belajar menyesuaikan ritme warga belajar yang bekerja, berwirausaha, atau memiliki kesibukan lain.',
  },
  {
    icon: 'shield',
    title: 'Berintegritas',
    description:
      'Menjunjung tinggi kejujuran akademik, kedisiplinan, serta akuntabilitas dalam setiap layanan pendidikan.',
  },
  {
    icon: 'bulb',
    title: 'Inovatif',
    description:
      'Terus mengembangkan media pembelajaran digital dan program keterampilan yang relevan dengan kebutuhan zaman.',
  },
];
---

<ProfileDetail profile={PROFILE_DATA['visi-misi']}>
  <div class="space-y-8">
    <!-- Visi PKBM -->
    <div>
      <div class="flex items-center gap-3">
        <span
          class="w-8 h-8 rounded-lg bg-[#FEF3DC] text-[#B4690E] inline-flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </span>
        <h2 class="text-base sm:text-lg font-extrabold text-[#0F2537] tracking-tight">
          Visi PKBM
        </h2>
      </div>

      <div class="mt-4 relative rounded-xl bg-[#F3F6FC] border border-[#E5EAF4] border-l-4 border-l-[#F59E0B] px-6 py-5 sm:px-7 sm:py-6">
        <span
          class="pointer-events-none absolute top-3 right-5 text-3xl sm:text-4xl font-serif font-bold text-[#F59E0B]/25 leading-none select-none"
          aria-hidden="true"
        >
          &rdquo;
        </span>
        <blockquote class="text-xs sm:text-[13.5px] font-bold text-[#0F2537] leading-relaxed pr-6">
          &ldquo;Menjadi lembaga pendidikan nonformal unggul, terpercaya, dan inklusif yang melahirkan lulusan berkarakter, kompeten, dan berdaya saing global.&rdquo;
        </blockquote>
      </div>
    </div>

    <!-- Misi PKBM -->
    <div>
      <div class="flex items-center gap-3">
        <span
          class="w-8 h-8 rounded-lg bg-[#EEF2FF] text-[#1E3A8A] inline-flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
            <line x1="4" y1="22" x2="4" y2="15" />
          </svg>
        </span>
        <h2 class="text-base sm:text-lg font-extrabold text-[#0F2537] tracking-tight">
          Misi PKBM
        </h2>
      </div>

      <div class="mt-4 space-y-3">
        {missions.map((mission) => (
          <div class="rounded-xl bg-[#F4F6FA] border border-[#EAEFF7] px-4 py-4 sm:px-5 flex items-start gap-4">
            <span class="w-7 h-7 rounded-md bg-[#0B192C] text-white text-[11px] font-extrabold inline-flex items-center justify-center shrink-0 mt-0.5">
              {mission.number}
            </span>
            <div>
              <h3 class="text-xs sm:text-[13px] font-extrabold text-[#0F2537]">
                {mission.title}
              </h3>
              <p class="mt-1 text-[11.5px] sm:text-xs text-slate-600 leading-relaxed">
                {mission.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Nilai Utama (Core Values) -->
    <div>
      <div class="flex items-center gap-3">
        <span
          class="w-8 h-8 rounded-lg bg-[#EEF2FF] text-[#1E3A8A] inline-flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12l4 6-10 13L2 9Z" />
            <path d="M11 3 8 9l4 13 4-13-3-6" />
            <path d="M2 9h20" />
          </svg>
        </span>
        <h2 class="text-base sm:text-lg font-extrabold text-[#0F2537] tracking-tight">
          Nilai Utama (Core Values)
        </h2>
      </div>

      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {coreValues.map((val) => (
          <div class="rounded-xl bg-[#F4F6FA] border border-[#EAEFF7] p-4 sm:p-5">
            <div class="flex items-center gap-2">
              <span class="text-[#B4690E] shrink-0" aria-hidden="true">
                {val.icon === 'users' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
                {val.icon === 'clock' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <polyline points="12 7 12 12 15 14" />
                  </svg>
                )}
                {val.icon === 'shield' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {val.icon === 'bulb' && (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
                    <path d="M9 18h6" />
                    <path d="M10 22h4" />
                  </svg>
                )}
              </span>
              <h3 class="text-xs sm:text-[13px] font-extrabold text-[#0F2537]">
                {val.title}
              </h3>
            </div>
            <p class="mt-2 text-[11.5px] text-slate-600 leading-relaxed">
              {val.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</ProfileDetail>
