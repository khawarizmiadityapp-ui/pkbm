---
import { WHATSAPP_NUMBER } from '../../data/contact';

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = WHATSAPP_NUMBER } = Astro.props;

interface StepItem {
  step: string;
  title: string;
  desc: string;
}

const steps: StepItem[] = [
  {
    step: "1",
    title: "Hubungi Kami",
    desc: "Hubungi PKBM via WhatsApp atau datang langsung ke kantor kami di Bandung",
  },
  {
    step: "2",
    title: "Konsultasi Program",
    desc: "Tim kami akan membantu memilih program yang tepat sesuai kebutuhan dan latar belakang pendidikan Anda",
  },
  {
    step: "3",
    title: "Siapkan Berkas",
    desc: "Siapkan dokumen: fotocopy KTP/KK, ijazah terakhir, dan pas foto. Bisa dikirim via Ekspedisi",
  },
  {
    step: "4",
    title: "Mulai Belajar",
    desc: "Setelah pendaftaran selesai, Anda langsung bisa mulai belajar secara online maupun tatap muka",
  },
];
---

<section id="cara-daftar" class="bg-[#0b2a47] text-white py-20 px-6 md:px-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block bg-[#e5a823]/15 text-[#e5a823] text-[11px] font-bold tracking-[0.2em] uppercase px-4 py-1.5 rounded-full">
        Mudah &amp; Cepat
      </span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Cara Mendaftar
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((item) => (
        <div class="bg-white/[0.06] border border-white/10 rounded-xl p-6 hover:border-[#e5a823]/40 hover:bg-white/[0.09] transition-all duration-300 flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-[#e5a823] text-white font-extrabold text-base flex items-center justify-center shrink-0 shadow-md shadow-[#e5a823]/20">
            {item.step}
          </div>

          <div>
            <h3 class="font-bold text-white text-base leading-snug">
              {item.title}
            </h3>
            <p class="text-[13px] text-slate-300 mt-2 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href={`https://wa.me/${whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#e5a823] hover:bg-[#d4971a] active:scale-95 text-white font-bold text-sm px-7 py-3.5 rounded-full shadow-[0_8px_24px_rgba(229,168,35,0.35)] transition-all"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
        <span>Mulai Konsultasi Gratis</span>
      </a>
    </div>
  </div>
</section>
