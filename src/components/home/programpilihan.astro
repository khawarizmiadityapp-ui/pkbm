---
interface ProgramItem {
  id: string;
  badge: string;
  title: string;
  level: string;
  description: string;
  imageUrl: string;
  href: string;
}

const programs: ProgramItem[] = [
  {
    id: "paket-a",
    badge: "Jenjang Dasar",
    title: "Kesetaraan Paket A",
    level: "Setara SD / MI",
    description: "Program pendidikan dasar bagi anak usia sekolah maupun dewasa untuk menguasai kompetensi dasar membaca, menulis, berhitung, dan budi pekerti.",
    imageUrl: "https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80",
    href: "/program/paket-a",
  },
  {
    id: "paket-b",
    badge: "Jenjang Menengah",
    title: "Kesetaraan Paket B",
    level: "Setara SMP / MTs",
    description: "Pendidikan kesetaraan tingkat menengah pertama. Fleksibel bagi lulusan SD/Paket A atau siswa putus sekolah yang ingin melanjutkan pendidikannya.",
    imageUrl: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=800&q=80",
    href: "/program/paket-b",
  },
  {
    id: "paket-c",
    badge: "Jenjang Lanjutan (Favorit)",
    title: "Kesetaraan Paket C",
    level: "Setara SMA / SMK",
    description: "Program kesetaraan jenjang atas (IPA/IPS). Ijazah resmi diakui negara dan dapat digunakan untuk melanjutkan kuliah (PTN/PTS) serta bekerja.",
    imageUrl: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80",
    href: "/program/paket-c",
  },
];
---

<section id="program" class="bg-white text-slate-900 pt-24 pb-20 px-6 md:px-10">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Pilihan Program Pendidikan Kesetaraan
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Layanan pendidikan bermutu dan fleksibel yang dirancang untuk membantu setiap warga belajar meraih ijazah resmi negara.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {programs.map((item) => (
        <div class="group bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="relative h-52 overflow-hidden bg-slate-100">
            <img
              src={item.imageUrl}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>
            <span class="absolute bottom-3 left-3 bg-amber-500 text-slate-950 font-bold text-xs px-3 py-1 rounded-md shadow-xs">
              {item.level}
            </span>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold text-amber-600 uppercase tracking-wide">
                {item.badge}
              </span>
              <h3 class="text-xl font-bold text-slate-900 mt-1 group-hover:text-amber-600 transition-colors">
                {item.title}
              </h3>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={item.href}
                class="text-sm font-semibold text-slate-700 hover:text-amber-600 transition-colors flex items-center gap-1"
              >
                <span>Pelajari Detail</span>
                <span class="text-amber-500">&rarr;</span>
              </a>
              <a
                href="https://wa.me/6285722459994"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 text-xs font-bold px-4 py-2 rounded-lg transition shadow-xs"
              >
                Daftar
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
