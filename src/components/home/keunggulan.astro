---
interface FeatureItem {
  title: string;
  desc: string;
  icon: string;
}

const features: FeatureItem[] = [
  {
    title: "Terakreditasi Resmi (A)",
    desc: "Lembaga resmi terdaftar di Kemdikbudristek dengan NPSN aktif, menjamin legalitas penuh proses belajar.",
    icon: "award",
  },
  {
    title: "Jadwal Belajar Fleksibel",
    desc: "Mendukung metode belajar daring (online) dan luring. Sangat cocok bagi pekerja, atlet, seniman, maupun wirausaha.",
    icon: "clock",
  },
  {
    title: "Ijazah Sah Diakui Negara",
    desc: "Ijazah kesetaraan memiliki hak sipil setara sekolah formal. Bisa dipakai kuliah di PTN/PTS, kerja BUMN, dan CPNS.",
    icon: "file-check",
  },
  {
    title: "Tanpa Batasan Usia",
    desc: "Membuka kesempatan seluas-luasnya bagi usia sekolah hingga usia dewasa yang ingin menuntaskan pendidikannya.",
    icon: "users",
  },
  {
    title: "Biaya Ringan & Terjangkau",
    desc: "Biaya pendidikan transparan dan terjangkau dengan skema pembayaran bertahap untuk mempermudah warga belajar.",
    icon: "badge-percent",
  },
  {
    title: "Tutor Berpengalaman & Ramah",
    desc: "Pengajar profesional yang siap membimbing materi belajar dengan metode yang mudah dipahami dan komunikatif.",
    icon: "sparkles",
  },
  {
    title: "Bimbingan Karir & Ujian",
    desc: "Pendampingan persiapan ujian, Asesmen Nasional, serta konsultasi penjurusan untuk masa depan Anda.",
    icon: "compass",
  },
];
---

<section class="bg-slate-50 text-slate-900 py-20 px-6 md:px-10 border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Keunggulan Belajar di PKBM
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Kami menyediakan ekosistem belajar yang ramah, adaptif, dan berorientasi pada kesuksesan setiap warga belajar.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.slice(0, 4).map((item) => (
        <div class="group bg-white hover:bg-[#006ce4] active:bg-[#0058be] rounded-3xl p-8 border border-slate-200/80 hover:border-transparent shadow-xs hover:shadow-2xl hover:shadow-blue-500/30 hover:-translate-y-2 active:scale-95 transition-all duration-300 flex flex-col items-center text-center cursor-pointer">
          <div class="w-14 h-14 rounded-full bg-blue-50 text-[#006ce4] group-hover:bg-white/20 group-hover:text-white flex items-center justify-center mb-6 transition-all duration-300">
            {item.icon === "award" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
              </svg>
            )}
            {item.icon === "clock" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            )}
            {item.icon === "file-check" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>
              </svg>
            )}
            {item.icon === "users" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            )}
          </div>
          <h3 class="font-bold text-slate-900 group-hover:text-white text-xl transition-colors duration-300">
            {item.title}
          </h3>
          <p class="text-sm text-slate-600 group-hover:text-white/90 mt-3 leading-relaxed transition-colors duration-300">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto mt-6">
      {features.slice(4).map((item) => (
        <div class="group bg-white hover:bg-[#006ce4] active:bg-[#0058be] rounded-3xl p-8 border border-slate-200/80 hover:border-transparent shadow-xs hover:shadow-2xl hover:shadow-blue-500/30 hover:-translate-y-2 active:scale-95 transition-all duration-300 flex flex-col items-center text-center cursor-pointer">
          <div class="w-14 h-14 rounded-full bg-blue-50 text-[#006ce4] group-hover:bg-white/20 group-hover:text-white flex items-center justify-center mb-6 transition-all duration-300">
            {item.icon === "badge-percent" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"/><path d="m15 9-6 6"/><path d="M9 9h.01"/><path d="M15 15h.01"/>
              </svg>
            )}
            {item.icon === "sparkles" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
              </svg>
            )}
            {item.icon === "compass" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
            )}
          </div>
          <h3 class="font-bold text-slate-900 group-hover:text-white text-xl transition-colors duration-300">
            {item.title}
          </h3>
          <p class="text-sm text-slate-600 group-hover:text-white/90 mt-3 leading-relaxed transition-colors duration-300">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
