---
interface NewsItem {
  id: string;
  title: string;
  date: string;
  category: string;
  imageUrl: string;
  href: string;
}

const articles: NewsItem[] = [
  {
    id: "1",
    title: "Workshop Kewirausahaan dan Keterampilan Digital untuk Warga Belajar Paket C",
    date: "14 Nov 2026",
    category: "Kegiatan",
    imageUrl: "https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=400&q=80",
    href: "/blog",
  },
  {
    id: "2",
    title: "Pendaftaran Gelombang 2 Program Kesetaraan Paket A, B, dan C Resmi Dibuka",
    date: "08 Nov 2026",
    category: "Informasi",
    imageUrl: "https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=400&q=80",
    href: "/blog",
  },
  {
    id: "3",
    title: "Kisah Inspiratif: Lulusan Paket C PKBM  Berhasil Lolos Masuk PTN Impian",
    date: "28 Okt 2026",
    category: "Prestasi",
    imageUrl: "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=400&q=80",
    href: "/blog",
  },
];
---

<section id="kabar" class="bg-white text-slate-900 py-20 px-6 md:px-10 border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Berita & Agenda Terbaru
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Ikuti perkembangan kegiatan belajar mengajar, pengumuman penting, dan kabar inspiratif dari PKBM .
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-5 bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-slate-200">
            <h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">
              Agenda Mendatang
            </h3>
            <a href="/agenda" class="text-xs font-semibold text-amber-600 hover:text-amber-700 transition">
              Lihat Agenda &rarr;
            </a>
          </div>

          <div class="mt-6 bg-white p-5 rounded-xl border border-slate-200/80 shadow-xs">
            <div class="flex gap-4">
              <div class="w-14 h-14 rounded-xl bg-[#0f172a] text-white flex flex-col items-center justify-center shrink-0">
                <span class="text-amber-400 font-black text-lg leading-none">15</span>
                <span class="text-[10px] text-slate-300 font-medium uppercase mt-0.5">Des</span>
              </div>
              <div>
                <span class="text-[11px] font-bold text-amber-600 uppercase">Asesmen Nasional</span>
                <h4 class="font-bold text-slate-900 text-sm leading-snug mt-0.5">
                  Simulasi & Ujian ANBK Berbasis Komputer Tahun Ajaran 2026
                </h4>
                <p class="text-xs text-slate-500 mt-2">
                  Wajib diikuti oleh seluruh warga belajar Paket B & Paket C tingkat akhir.
                </p>
              </div>
            </div>
          </div>

          <div class="mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200/60 text-xs text-amber-900 leading-relaxed">
            <strong>Catatan:</strong> Informasi ruang ujian dan kartu peserta dapat diambil di sekretariat atau melalui portal warga belajar.
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-slate-200 text-right">
          <a href="/agenda" class="text-xs font-semibold text-slate-600 hover:text-amber-600 transition">
            Lihat Kalender Akademik Lengkap &rarr;
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8">
        <div class="flex items-center justify-between pb-4 border-b border-slate-200">
          <h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">
            Artikel & Kabar Terkini
          </h3>
          <a href="/blog" class="text-xs font-semibold text-amber-600 hover:text-amber-700 transition">
            Lihat Semua Artikel &rarr;
          </a>
        </div>

        <div class="divide-y divide-slate-100 mt-2">
          {articles.map((item) => (
            <a href={item.href} class="py-4 flex gap-4 group items-center transition">
              <img
                src={item.imageUrl}
                alt={item.title}
                class="w-20 h-20 sm:w-24 sm:h-20 rounded-xl object-cover shrink-0 bg-slate-100 group-hover:opacity-90 transition"
                loading="lazy"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 text-[11px] text-slate-500 mb-1">
                  <span class="font-bold text-amber-600">{item.category}</span>
                  <span>&bull;</span>
                  <span>{item.date}</span>
                </div>
                <h4 class="font-bold text-sm sm:text-base text-slate-900 group-hover:text-amber-600 transition-colors line-clamp-2 leading-snug">
                  {item.title}
                </h4>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
