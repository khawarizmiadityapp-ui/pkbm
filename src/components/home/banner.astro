---
import { Image } from 'astro:assets';
import bannerImage1 from '../../images/banner.webp';
import bannerImage2 from '../../images/Banner-Menggunakan-Format-WebP-di-WordPress.webp';

interface StatItem {
  value: string;
  label: string;
}

interface Props {
  badge?: string;
  title1?: string;
  title2?: string;
  description?: string;
  whatsappNumber?: string;
  programHref?: string;
  stats?: StatItem[];
}

const {
  badge = "BEBAS DOMISILI — SELURUH INDONESIA",
  title1 = "Daftar Dari Mana",
  title2 = "Saja, Kapan Saja!",
  description = "Menerima pendaftaran warga belajar baru & pindahan dari seluruh nusantara bahkan luar negeri.",
  whatsappNumber = "6285722459994",
  programHref = "/program",
  stats = [
    { value: "Akreditasi A", label: "RESMI KEMDIKBUD" },
    { value: "1.500+", label: "ALUMNI WARGA BELAJAR" },
    { value: "100%", label: "FLEKSIBEL ONLINE & OFFLINE" },
    { value: "Ijazah Resmi", label: "BISA KULIAH & KERJA" },
  ],
} = Astro.props;
---

<section class="relative">
  <div class="relative min-h-[500px] lg:min-h-[570px] flex items-center overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div id="banner-track" class="flex w-[300%] h-full">
        <div class="w-1/3 h-full relative shrink-0">
          <Image
            src={bannerImage1}
            alt="Warga Belajar PKBM"
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>
        <div class="w-1/3 h-full relative shrink-0">
          <Image
            src={bannerImage2}
            alt="Kegiatan Belajar PKBM"
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>
        <div class="w-1/3 h-full relative shrink-0">
          <Image
            src={bannerImage1}
            alt="Warga Belajar PKBM"
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <div
      class="absolute inset-0 bg-gradient-to-r from-[#0a111c] via-[#0a111c]/95 md:via-[#0a111c]/80 to-[#0a111c]/40 md:to-transparent pointer-events-none"
    >
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 py-16 sm:py-20 w-full">
      <div class="max-w-2xl space-y-6">
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-0.5 bg-amber-400"></span>
          <span class="text-amber-400 font-bold text-xs tracking-wider uppercase">
            {badge}
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15]">
          {title1} <br />
          <span class="text-white">{title2}</span>
        </h1>

        <p class="text-slate-200 text-base sm:text-lg leading-relaxed max-w-xl font-normal">
          {description}
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href={`https://wa.me/${whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-sm px-7 py-3.5 rounded-full shadow-lg shadow-amber-500/20 transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Daftar via WhatsApp</span>
          </a>

          <a
            href={programHref}
            class="inline-flex items-center justify-center border border-white/40 hover:border-white/80 bg-white/5 hover:bg-white/15 text-white font-medium text-sm px-7 py-3.5 rounded-full transition-all active:scale-95"
          >
            Lihat Program
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-4 text-xs sm:text-sm text-slate-200">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">&#10003;</span>
            <span>Terakreditasi A</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">&#10003;</span>
            <span>NPSN P9948537</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">&#10003;</span>
            <span>Ijazah resmi Negara</span>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-4">
          <button
            type="button"
            aria-label="Slide 1"
            data-index="0"
            class="banner-dot h-2 w-7 rounded-full bg-amber-400 transition-all duration-300 cursor-pointer"
          >
          </button>
          <button
            type="button"
            aria-label="Slide 2"
            data-index="1"
            class="banner-dot h-2 w-2.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300 cursor-pointer"
          >
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 translate-y-1/2 z-20 px-6 pointer-events-none">
    <div class="max-w-5xl mx-auto bg-[#0b1424] border border-slate-800/90 rounded-2xl sm:rounded-3xl shadow-2xl shadow-slate-950/40 py-5 sm:py-6 px-4 sm:px-8 pointer-events-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 text-center">
        {stats.map((item, index) => (
          <div
            class:list={[
              "px-3 flex flex-col justify-center",
              index % 2 === 0 ? "border-r border-slate-800/80 md:border-r" : "",
              index === 1 ? "md:border-r border-slate-800/80" : "",
              index === 2 ? "border-r border-slate-800/80" : "",
              index === 3 ? "border-none" : "",
            ]}
          >
            <div class="text-xl sm:text-2xl lg:text-3xl font-black text-amber-400 leading-tight">
              {item.value}
            </div>
            <div class="text-[10px] sm:text-xs text-slate-300 font-bold tracking-wider uppercase mt-1.5">
              {item.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('banner-track');
  const dots = document.querySelectorAll('.banner-dot');
  let currentIndex = 0;
  const totalSlides = 2;

  function updateSlide(index: number, withTransition = true) {
    if (!track) return;
    if (!withTransition) {
      track.style.transition = 'none';
    } else {
      track.style.transition = 'transform 1000ms cubic-bezier(0.4, 0, 0.2, 1)';
    }
    track.style.transform = `translateX(-${index * (100 / 3)}%)`;

    dots.forEach((dot, i) => {
      const active = index % totalSlides;
      if (i === active) {
        dot.classList.add('bg-amber-400', 'w-7');
        dot.classList.remove('bg-white/40', 'w-2.5');
      } else {
        dot.classList.remove('bg-amber-400', 'w-7');
        dot.classList.add('bg-white/40', 'w-2.5');
      }
    });
  }

  function nextSlide() {
    currentIndex++;
    updateSlide(currentIndex, true);

    if (currentIndex === totalSlides) {
      setTimeout(() => {
        currentIndex = 0;
        updateSlide(0, false);
      }, 1000);
    }
  }

  let timer = setInterval(nextSlide, 5000);

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      currentIndex = parseInt(dot.getAttribute('data-index') || '0', 10);
      updateSlide(currentIndex, true);
      timer = setInterval(nextSlide, 5000);
    });
  });
</script>
