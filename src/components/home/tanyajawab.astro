---
interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "Apakah ijazah dari PKBM  sah dan diakui negara?",
    answer: "Ya, 100% resmi dan sah! PKBM terakreditasi A oleh BAN-PAUD PNF Kemdikbudristek. Ijazah kesetaraan Paket A, B, dan C memiliki hak sipil dan legalitas setara sekolah formal, bisa digunakan untuk mendaftar kuliah di PTN/PTS, melamar kerja BUMN/swasta, hingga mendaftar CPNS.",
  },
  {
    question: "Apakah ada batasan usia untuk mendaftar?",
    answer: "Tidak ada batasan usia sama sekali. Program pendidikan kesetaraan terbuka bagi siapa saja, mulai dari usia sekolah hingga usia dewasa yang ingin menuntaskan pendidikannya.",
  },
  {
    question: "Bagaimana sistem pembelajarannya? Apakah bisa online bagi yang bekerja?",
    answer: "Sangat bisa. Kami menerapkan kurikulum fleksibel dengan metode belajar daring (online) dan modul digital mandiri, sehingga warga belajar yang berstatus pekerja, atlet, atau di luar kota tetap dapat belajar tanpa mengganggu aktivitas utama.",
  },
  {
    question: "Bagaimana jika saya siswa pindahan / putus sekolah di tengah jalan?",
    answer: "Bisa langsung melanjutkan! Anda cukup melampirkan raport terakhir dari sekolah sebelumnya, dan jenjang kelas akan disesuaikan dengan riwayat belajar Anda tanpa perlu mengulang dari awal.",
  },
  {
    question: "Apa saja dokumen syarat pendaftarannya?",
    answer: "Syaratnya sangat mudah: Scan/Foto KTP, Kartu Keluarga (KK), Akta Kelahiran, Pas Foto terbaru, dan Ijazah terakhir (jika ada). Semua berkas bisa dikirimkan langsung secara online via WhatsApp.",
  },
  {
    question: "Apakah biaya pendidikan bisa diangsur / dicicil?",
    answer: "Tentu saja. Kami mengedepankan kemudahan akses pendidikan bagi masyarakat dengan biaya yang terjangkau serta fasilitas pembayaran cicilan berkala tanpa bunga.",
  },
];
---

<section id="faq" class="bg-slate-50 text-slate-900 py-14 sm:py-16 px-6 md:px-10 border-t border-slate-200">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Pertanyaan yang Sering Diajukan
      </h2>
      <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
        Punya pertanyaan seputar pendaftaran, legalitas, atau jadwal belajar? Temukan jawabannya di bawah ini.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((item, index) => (
        <details
          class="group bg-white rounded-xl border border-slate-200/90 shadow-2xs overflow-hidden transition-all duration-200"
          open={index === 0}
        >
          <summary class="flex items-center justify-between py-3.5 px-4 sm:px-5 cursor-pointer font-bold text-sm sm:text-[15px] text-slate-800 select-none group-open:text-amber-600 group-open:border-b group-open:border-slate-100 transition-colors">
            <span>{item.question}</span>
            <span class="w-6 h-6 rounded-full bg-slate-100 group-open:bg-amber-100 text-slate-600 group-open:text-amber-700 flex items-center justify-center shrink-0 ml-3 transition-transform duration-300 group-open:rotate-180">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="px-4 sm:px-5 py-3.5 text-xs sm:text-sm text-slate-600 leading-relaxed bg-slate-50/40">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <p class="text-center text-xs text-slate-500 mt-6">
      Masih memiliki pertanyaan lain yang belum terjawab? 
      <a href="" target="_blank" rel="noopener noreferrer" class="text-amber-600 font-bold hover:underline">
        Tanyakan langsung ke Tim Konsultasi kami &rarr;
      </a>
    </p>
  </div>

  <div class="max-w-5xl mx-auto mt-12 sm:mt-14">
    <div class="bg-[#0b1424] rounded-2xl p-6 sm:p-8 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-5 shadow-xl shadow-slate-950/20">
      <div>
        <h3 class="text-xl sm:text-2xl font-extrabold text-white leading-tight">
          Siap Meraih Ijazah & Masa Depan Impian Anda?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-1.5 max-w-xl">
          Pendaftaran warga belajar baru telah dibuka. Amankan kursi belajarmu sekarang juga!
        </p>
      </div>

      <a
        href=""
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs sm:text-sm px-6 py-3 rounded-full shadow-md shadow-amber-500/20 transition-all"
      >
        <svg class="w-4 h-4 fill-white shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span>Daftar via WhatsApp Sekarang</span>
      </a>
    </div>
  </div>
</section>
