---
import { WHATSAPP_NUMBER } from '../../data/contact';

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = WHATSAPP_NUMBER } = Astro.props;

interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "Apakah ijazah dari PKBM  sah dan diakui negara?",
    answer: "Ya, 100% resmi dan sah! PKBM terakreditasi A oleh BAN-PAUD PNF Kemdikbudristek. Ijazah kesetaraan Paket A, B, dan C memiliki hak sipil dan legalitas setara sekolah formal, bisa digunakan untuk mendaftar kuliah di PTN/PTS, melamar kerja BUMN/swasta, hingga mendaftar CPNS.",
  },
  {
    question: "Apakah ada batasan usia untuk mendaftar?",
    answer: "Tidak ada batasan usia sama sekali. Program pendidikan kesetaraan terbuka bagi siapa saja, mulai dari usia sekolah hingga usia dewasa yang ingin menuntaskan pendidikannya.",
  },
  {
    question: "Bagaimana sistem pembelajarannya? Apakah bisa online bagi yang bekerja?",
    answer: "Sangat bisa. Kami menerapkan kurikulum fleksibel dengan metode belajar daring (online) dan modul digital mandiri, sehingga warga belajar yang berstatus pekerja, atlet, atau di luar kota tetap dapat belajar tanpa mengganggu aktivitas utama.",
  },
  {
    question: "Bagaimana jika saya siswa pindahan / putus sekolah di tengah jalan?",
    answer: "Bisa langsung melanjutkan! Anda cukup melampirkan raport terakhir dari sekolah sebelumnya, dan jenjang kelas akan disesuaikan dengan riwayat belajar Anda tanpa perlu mengulang dari awal.",
  },
  {
    question: "Apa saja dokumen syarat pendaftarannya?",
    answer: "Syaratnya sangat mudah: Scan/Foto KTP, Kartu Keluarga (KK), Akta Kelahiran, Pas Foto terbaru, dan Ijazah terakhir (jika ada). Semua berkas bisa dikirimkan langsung secara online via WhatsApp.",
  },
  {
    question: "Apakah biaya pendidikan bisa diangsur / dicicil?",
    answer: "Tentu saja. Kami mengedepankan kemudahan akses pendidikan bagi masyarakat dengan biaya yang terjangkau serta fasilitas pembayaran cicilan berkala tanpa bunga.",
  },
];
---

<section id="faq" class="bg-slate-50 text-slate-900 py-14 sm:py-16 px-6 md:px-10 border-t border-slate-200">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Pertanyaan yang Sering Diajukan
      </h2>
      <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
        Punya pertanyaan seputar pendaftaran, legalitas, atau jadwal belajar? Temukan jawabannya di bawah ini.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((item, index) => (
        <details
          data-faq-item
          class="group bg-white rounded-xl border border-slate-200/90 shadow-2xs overflow-hidden transition-colors duration-200"
          open={index === 0}
        >
          <summary
            data-faq-summary
            class="flex items-center justify-between py-3.5 px-4 sm:px-5 cursor-pointer font-bold text-sm sm:text-[15px] text-slate-800 select-none group-open:text-amber-600 group-open:border-b group-open:border-slate-100 transition-colors"
          >
            <span>{item.question}</span>
            <span class="w-6 h-6 rounded-full bg-slate-100 group-open:bg-amber-100 text-slate-600 group-open:text-amber-700 flex items-center justify-center shrink-0 ml-3 transition-transform duration-300 group-open:rotate-180">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div
            data-faq-content
            class="px-4 sm:px-5 py-3.5 text-xs sm:text-sm text-slate-600 leading-relaxed bg-slate-50/40"
          >
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <p class="text-center text-xs text-slate-500 mt-6">
      Masih memiliki pertanyaan lain yang belum terjawab? 
      <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="text-amber-600 font-bold hover:underline">
        Tanyakan langsung ke Tim Konsultasi kami &rarr;
      </a>
    </p>
  </div>
</section>

<script>
  const faqItems = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'),
  );
  const animations = new WeakMap<HTMLDetailsElement, Animation>();
  const closingState = new WeakMap<HTMLDetailsElement, boolean>();

  function cancelAnimation(details: HTMLDetailsElement) {
    const existing = animations.get(details);
    if (existing) {
      existing.cancel();
      animations.delete(details);
    }
  }

  function shrinkItem(details: HTMLDetailsElement) {
    const summary = details.querySelector<HTMLElement>('[data-faq-summary]');
    const content = details.querySelector<HTMLElement>('[data-faq-content]');
    if (!summary || !details.open) return;

    cancelAnimation(details);
    closingState.set(details, true);

    const cs = getComputedStyle(details);
    const borderY = parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
    const startHeight = `${details.offsetHeight}px`;
    const endHeight = `${summary.offsetHeight + borderY}px`;

    details.style.overflow = 'hidden';
    if (content) {
      content.animate(
        [
          { opacity: 1, transform: 'translateY(0)' },
          { opacity: 0, transform: 'translateY(-4px)' },
        ],
        { duration: 200, easing: 'ease-out', fill: 'forwards' },
      );
    }

    const anim = details.animate(
      { height: [startHeight, endHeight] },
      { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
    );

    animations.set(details, anim);
    anim.onfinish = () => {
      details.open = false;
      details.style.height = '';
      details.style.overflow = '';
      closingState.set(details, false);
      animations.delete(details);
      content?.getAnimations().forEach((a) => a.cancel());
    };
    anim.oncancel = () => {
      closingState.set(details, false);
    };
  }

  function expandItem(details: HTMLDetailsElement) {
    const summary = details.querySelector<HTMLElement>('[data-faq-summary]');
    const content = details.querySelector<HTMLElement>('[data-faq-content]');
    if (!summary) return;

    cancelAnimation(details);
    closingState.set(details, false);

    const startHeight = `${details.offsetHeight}px`;
    details.open = true;

    const endHeight = `${details.offsetHeight}px`;
    details.style.overflow = 'hidden';

    if (content) {
      content.getAnimations().forEach((a) => a.cancel());
      content.animate(
        [
          { opacity: 0, transform: 'translateY(-4px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ],
        { duration: 280, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      );
    }

    const anim = details.animate(
      { height: [startHeight, endHeight] },
      { duration: 300, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
    );

    animations.set(details, anim);
    anim.onfinish = () => {
      details.style.height = '';
      details.style.overflow = '';
      animations.delete(details);
    };
  }

  for (const item of faqItems) {
    const summary = item.querySelector<HTMLElement>('[data-faq-summary]');
    summary?.addEventListener('click', (event) => {
      event.preventDefault();
      const isClosing = closingState.get(item) === true;

      if (item.open && !isClosing) {
        shrinkItem(item);
        return;
      }

      for (const other of faqItems) {
        if (other !== item && other.open) {
          shrinkItem(other);
        }
      }

      expandItem(item);
    });
  }
</script>
