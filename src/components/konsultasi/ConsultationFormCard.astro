---
interface RoleOption {
  id: string;
  title: string;
  description: string;
  icon: 'cap' | 'family' | 'building';
}

const roleOptions: RoleOption[] = [
  {
    id: 'calon-warga-belajar',
    title: 'Calon Warga Belajar',
    description: 'Konsultasi & daftar untuk diri sendiri',
    icon: 'cap',
  },
  {
    id: 'orang-tua-wali',
    title: 'Orang Tua / Wali',
    description: 'Mendaftarkan anak atau keluarga',
    icon: 'family',
  },
  {
    id: 'lembaga-mitra-alumni',
    title: 'Lembaga / Mitra / Alumni',
    description: 'Instansi, kerja sama, atau alumni',
    icon: 'building',
  },
];
---

<section
  class="lg:col-span-7 bg-[#FAF6EC] px-4 py-8 sm:px-8 sm:py-12 lg:px-12 flex flex-col items-center justify-center"
  aria-label="Formulir Konsultasi"
>
  <div class="w-full max-w-[540px]">
    <!-- Main Form Card -->
    <div class="bg-white rounded-2xl border border-[#ECE8DE] shadow-[0_12px_36px_rgba(15,37,55,0.06)] p-6 sm:p-8 lg:p-9">
      <p class="text-[10.5px] font-bold uppercase tracking-[0.1em] text-[#B4690E]">
        FORMULIR KONSULTASI
      </p>

      <h2 class="mt-1.5 text-xl sm:text-2xl font-extrabold text-[#0F2537] tracking-tight">
        Lengkapi informasi berikut
      </h2>

      <p class="mt-1.5 text-xs text-[#64748B] leading-relaxed">
        Kolom bertanda <span class="text-[#DC2626] font-semibold">*</span> wajib diisi. Data yang sudah diisi mungkin tersimpan otomatis.
      </p>

      <!-- Official Institution Info Banner -->
      <div class="mt-6 rounded-xl bg-[#FEF7E6] border border-[#F6E2B3] p-4 flex items-start gap-3.5">
        <div
          class="w-9 h-9 rounded-lg bg-[#F5E4BE] text-[#9A6310] inline-flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" />
          </svg>
        </div>

        <div class="min-w-0">
          <h3 class="text-xs sm:text-[13px] font-bold text-[#0F2537]">
            Lembaga resmi terdaftar
          </h3>
          <p class="mt-0.5 text-[11.5px] text-[#475569]">
            NPSN <strong class="font-bold text-[#0F2537]">P9948537</strong> &middot; Terakreditasi <strong class="font-bold text-[#0F2537]">A</strong>
          </p>
          <p class="mt-1 text-[11px] text-[#64748B] leading-relaxed">
            Jalan Pesona Raya, Perum Graha Pesona Blok A No. 6, Bandung. PKBM INTAN <strong class="font-bold text-[#0F2537]">tidak memiliki kantor cabang</strong> di kota lain.
          </p>
        </div>
      </div>

      <!-- Step 1 Role Question -->
      <fieldset class="mt-6">
        <legend class="text-xs sm:text-[13px] font-bold text-[#0F2537]">
          1. Saya menghubungi sebagai <span class="text-[#DC2626]">*</span>
        </legend>

        <div class="mt-3.5 space-y-3" role="radiogroup">
          {roleOptions.map((option) => (
            <label
              data-role-option
              class="group flex items-center gap-3.5 rounded-xl border border-[#E2E8F0] bg-white hover:border-[#E9A820] hover:bg-[#FFFDF7] px-4 py-3.5 cursor-pointer transition-all shadow-[0_1px_2px_rgba(15,37,55,0.02)]"
            >
              <input
                type="radio"
                name="consultation_role"
                value={option.id}
                class="sr-only"
              />

              <span
                class="w-10 h-10 rounded-lg bg-[#FBF2DC] text-[#9A6310] inline-flex items-center justify-center shrink-0 transition-colors group-hover:bg-[#F7E7BE]"
                aria-hidden="true"
              >
                {option.icon === 'cap' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zm-7 9.18V16l7 3.82L19 16v-3.82l-7 3.82-7-3.82z" />
                  </svg>
                )}
                {option.icon === 'family' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                  </svg>
                )}
                {option.icon === 'building' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" />
                  </svg>
                )}
              </span>

              <span class="min-w-0 flex-1">
                <span class="block text-[13px] font-bold text-[#0F2537] leading-snug">
                  {option.title}
                </span>
                <span class="block mt-0.5 text-[11.5px] text-[#64748B]">
                  {option.description}
                </span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    </div>

    <!-- Bottom Caption -->
    <p class="mt-6 text-center text-[11px] text-[#94A3B8]">
      &copy; 2026 PKBM INTAN Bandung &ndash; Sistem Layanan Informasi Cepat
    </p>
  </div>
</section>

<script>
  const roleCards = Array.from(document.querySelectorAll<HTMLLabelElement>('[data-role-option]'));

  for (const card of roleCards) {
    const radio = card.querySelector<HTMLInputElement>('input[type="radio"]');
    radio?.addEventListener('change', () => {
      for (const item of roleCards) {
        const input = item.querySelector<HTMLInputElement>('input[type="radio"]');
        const isChecked = Boolean(input?.checked);
        item.classList.toggle('border-[#E9A820]', isChecked);
        item.classList.toggle('bg-[#FFFDF7]', isChecked);
        item.classList.toggle('ring-2', isChecked);
        item.classList.toggle('ring-[#E9A820]/25', isChecked);
        item.classList.toggle('border-[#E2E8F0]', !isChecked);
        item.classList.toggle('bg-white', !isChecked);
      }
    });
  }
</script>
