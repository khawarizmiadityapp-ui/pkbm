---
import { WHATSAPP_NUMBER } from '../data/contact';

interface Props {
  brandName?: string;
  tagline?: string;
  description?: string;
  npsn?: string;
  address?: string;
  phone?: string;
  email?: string;
  hours?: string;
  whatsappNumber?: string;
}

const {
  brandName = "PKBM ",
  tagline = "Lorem ipsum dolor",
  description = "PKBM  lorem ipsum dolor sit amet",
  npsn = "Lorem ipsum dolor sit amet",
  address = "Perum Graha Pesona, Blok A No 6, Kelurahan Cisaranten Wetan, Kecamatan Cinambo, Kota Bandung, Jawa Barat",
  phone = "0857-2245-9994",
  email = "support@pkbm.id",
  hours = "Senin - Jum'at: 08.00–17.00 WIB, Sabtu 08.00–12.00 WIB",
  whatsappNumber = WHATSAPP_NUMBER,
} = Astro.props;

const currentYear = new Date().getFullYear();

const programs = [
  { label: "Paket A", href: "/program/paket-a" },
  { label: "Paket B", href: "/program/paket-b" },
  { label: "Paket C", href: "/program/paket-c" },
];

const galleryLinks = [
  { label: "Galeri Foto", href: "/galeri/foto" },
  { label: "Galeri Video", href: "/galeri/video" },
];

const quickLinks = [
  { label: "Beranda", href: "/" },
  { label: "Visi & Misi", href: "/visi-misi" },
  { label: "Blog & Artikel", href: "/blog" },
  { label: "Kontak Kami", href: "/kontak" },
];
---

<footer class="bg-[#0b1320] text-slate-300 pt-16 pb-8 border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800">
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center p-2 text-white border border-white/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
              <path d="m6 6 6-3 6 3"></path>
              <path d="m6 10 6-3 6 3"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-extrabold text-white text-lg tracking-wide leading-tight">{brandName}</h3>
            <p class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">{tagline}</p>
          </div>
        </div>

        <p class="text-xs leading-relaxed text-slate-400 pr-4">
          {description}
        </p>

        <div class="inline-block bg-[#111c2e] border border-slate-700/60 rounded-lg px-4 py-2">
          <span class="block text-[11px] text-slate-400 font-medium">NPSN</span>
          <span class="text-amber-400 font-bold text-base tracking-wide">{npsn}</span>
        </div>
      </div>

      <div class="lg:col-span-3 space-y-4">
        <div>
          <h4 class="font-bold text-white text-sm tracking-wide">Alamat & Kontak</h4>
          <div class="w-8 h-0.5 bg-amber-400 mt-1.5 rounded-full"></div>
        </div>

        <ul class="space-y-3.5 text-xs text-slate-400">
          <li class="flex items-start gap-2.5">
            <span class="text-amber-400 mt-0.5 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span class="leading-relaxed">{address}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span>{phone}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <span class="text-amber-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <span>{email}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-400 mt-0.5 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <span class="leading-relaxed">{hours}</span>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2 space-y-6">
        <div class="space-y-3">
          <div>
            <h4 class="font-bold text-white text-sm tracking-wide">Program</h4>
            <div class="w-8 h-0.5 bg-amber-400 mt-1.5 rounded-full"></div>
          </div>
          <ul class="space-y-2 text-xs">
            {programs.map((prog) => (
              <li>
                <a href={prog.href} class="text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors group">
                  <span class="text-amber-400 text-[10px] group-hover:translate-x-0.5 transition-transform">&rsaquo;</span>
                  <span>{prog.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <div>
            <h4 class="font-bold text-white text-sm tracking-wide">Galeri</h4>
            <div class="w-8 h-0.5 bg-amber-400 mt-1.5 rounded-full"></div>
          </div>
          <ul class="space-y-2 text-xs">
            {galleryLinks.map((gal) => (
              <li>
                <a href={gal.href} class="text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors group">
                  <span class="text-amber-400 text-[10px] group-hover:translate-x-0.5 transition-transform">&rsaquo;</span>
                  <span>{gal.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-3 space-y-4">
        <div>
          <h4 class="font-bold text-white text-sm tracking-wide">Tautan</h4>
          <div class="w-8 h-0.5 bg-amber-400 mt-1.5 rounded-full"></div>
        </div>

        <ul class="space-y-2 text-xs">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors group">
                <span class="text-amber-400 text-[10px] group-hover:translate-x-0.5 transition-transform">&rsaquo;</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-2">
          <a
            href={`https://wa.me/${whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full justify-center inline-flex items-center gap-2.5 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-sm px-7 py-3.5 rounded-full shadow-lg shadow-amber-500/20 transition-all"
          >
            <svg class="w-4 h-4 fill-white shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span>Chat WhatsApp Kami</span>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p class="text-center md:text-left">
        &copy; {currentYear} {brandName} &mdash; {tagline}. All Rights Reserved.
      </p>
      <a href="/admin" class="hover:text-slate-300 transition-colors">
        Masih Tahap Proses
      </a>
    </div>
  </div>

  <a
    href={`https://wa.me/${whatsappNumber}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp"
    class="fixed bottom-6 right-6 w-14 h-14 bg-[#25D366] hover:bg-[#20bd5a] text-white rounded-full shadow-2xl flex items-center justify-center z-50 hover:scale-110 active:scale-95 transition-transform"
  >
    <svg class="w-8 h-8 fill-white shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
  </a>
</footer>
