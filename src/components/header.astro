---
interface DropdownSubItem {
  label: string;
  sublabel?: string;
  href: string;
  icon: 'file' | 'target' | 'star' | 'cap' | 'photo' | 'video';
}

interface NavItem {
  label: string;
  href: string;
  children?: DropdownSubItem[];
}

interface Props {
  brandName?: string;
  tagline?: string;
  navLinks?: NavItem[];
}

const {
  brandName = "PKBM",
  tagline = "Lorem ipsum",
  navLinks = [
    { label: "Beranda", href: "/" },
    {
      label: "Profil",
      href: "/profil",
      children: [
        { label: "Tentang PKBM", href: "/profil", icon: "file" },
        { label: "Visi dan Misi", href: "/visi-misi", icon: "target" },
        { label: "Filosofi Logo", href: "/filosofi-logo", icon: "star" },
      ],
    },
    {
      label: "Program",
      href: "/program",
      children: [
        {
          label: "Kesetaraan Paket A",
          sublabel: "(Setara SD / MI)",
          href: "/program/paket-a",
          icon: "cap",
        },
        {
          label: "Kesetaraan Paket B",
          sublabel: "(Setara SMP / MTs)",
          href: "/program/paket-b",
          icon: "cap",
        },
        {
          label: "Kesetaraan Paket C",
          sublabel: "(Setara SMA / MA)",
          href: "/program/paket-c",
          icon: "cap",
        },
      ],
    },
    {
      label: "Galeri",
      href: "/galeri",
      children: [
        { label: "Galeri Foto", href: "/galeri/foto", icon: "photo" },
        { label: "Galeri Video", href: "/galeri/video", icon: "video" },
      ],
    },
    { label: "Blog", href: "/blog" },
    { label: "Agenda", href: "/agenda" },
    { label: "Kontak", href: "/kontak" },
  ],
} = Astro.props;

const mainLinks = navLinks.filter((item) => item.label.toLowerCase() !== "kontak");
const contactLink = navLinks.find((item) => item.label.toLowerCase() === "kontak") ?? {
  label: "Kontak",
  href: "/kontak",
};

const currentPath = Astro.url.pathname;

function isRouteActive(item: NavItem): boolean {
  if (item.href === "/") return currentPath === "/";
  if (currentPath.startsWith(item.href)) return true;
  return (
    item.children?.some((sub) => {
      const baseHref = sub.href.split("#")[0];
      return baseHref && baseHref !== "/" && currentPath.startsWith(baseHref);
    }) ?? false
  );
}
---

<header class="relative z-50 bg-[#111e2e] text-white px-6 md:px-10 py-3.5 flex items-center justify-between shadow-md">
  <a href="/" class="flex items-center gap-3 group shrink-0">
    <div class="w-10 h-10 rounded-xl bg-amber-400 flex items-center justify-center text-slate-900 shadow-md group-hover:scale-105 transition-transform">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path>
        <path d="M22 10v6"></path>
        <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
      </svg>
    </div>
    <div class="flex flex-col">
      <span class="font-bold text-white text-base leading-tight tracking-wide">
        {brandName}
      </span>
      <span class="text-xs text-slate-400">
        {tagline}
      </span>
    </div>
  </a>

  <!-- Desktop Navigation -->
  <nav class="hidden md:flex items-center gap-7" aria-label="Navigasi utama">
    {mainLinks.map((item, idx) => {
      const isActive = isRouteActive(item);
      const hasChildren = Boolean(item.children && item.children.length > 0);
      const panelId = `nav-dropdown-${idx}`;

      if (!hasChildren) {
        return (
          <a
            href={item.href}
            class:list={[
              "relative py-1 text-sm font-semibold transition-colors duration-200 group",
              isActive
                ? "text-amber-400"
                : "text-slate-300 hover:text-amber-400",
            ]}
          >
            <span>{item.label}</span>
            <span
              class:list={[
                "absolute -bottom-3.5 left-0 w-full h-[2.5px] bg-amber-400 rounded-full transition-all duration-300",
                isActive
                  ? "scale-x-100 opacity-100"
                  : "scale-x-0 opacity-0 group-hover:scale-x-100 group-hover:opacity-100",
              ]}
            ></span>
          </a>
        );
      }

      return (
        <div class="relative" data-dropdown-container>
          <button
            type="button"
            data-dropdown-trigger={panelId}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls={panelId}
            class:list={[
              "relative py-1 text-sm font-semibold transition-colors duration-200 group cursor-pointer inline-flex items-center gap-1 focus:outline-none",
              isActive
                ? "text-amber-400"
                : "text-slate-300 hover:text-amber-400",
            ]}
          >
            <span>{item.label}</span>
            <span
              data-dropdown-bar
              class:list={[
                "absolute -bottom-3.5 left-0 w-full h-[3px] bg-amber-400 rounded-full transition-all duration-200",
                isActive
                  ? "scale-x-100 opacity-100"
                  : "scale-x-0 opacity-0 group-hover:scale-x-100 group-hover:opacity-100",
              ]}
            ></span>
          </button>

          <div
            id={panelId}
            data-dropdown-panel
            role="menu"
            class="hidden absolute left-0 top-full mt-5 min-w-[260px] bg-white rounded-b-xl rounded-tr-xl border border-slate-200 border-t-2 border-t-amber-400 shadow-xl py-2.5 z-50"
          >
            {item.children!.map((sub) => (
              <a
                href={sub.href}
                role="menuitem"
                class="flex items-center gap-3.5 px-5 py-3 text-sm text-[#102F4D] hover:bg-slate-50 transition-colors whitespace-nowrap group/item"
              >
                <span class="text-amber-500 shrink-0" aria-hidden="true">
                  {sub.icon === "file" && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 7V3.5L19.5 8H15v1zm-7 4h8v1.5H8V13zm0 3.5h8V18H8v-1.5zm0-7h4V11H8V9.5z" />
                    </svg>
                  )}
                  {sub.icon === "target" && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="9" />
                      <circle cx="12" cy="12" r="5" />
                      <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                    </svg>
                  )}
                  {sub.icon === "star" && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.5l2.93 5.94 6.56.95-4.74 4.62 1.12 6.53L12 17.45l-5.87 3.09 1.12-6.53L2.51 9.39l6.56-.95L12 2.5z" />
                    </svg>
                  )}
                  {sub.icon === "cap" && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zm-7 9.18V16l7 3.82L19 16v-3.82l-7 3.82-7-3.82z" />
                    </svg>
                  )}
                  {sub.icon === "photo" && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="8.5" cy="10" r="1.5" fill="currentColor" />
                      <path d="m21 15-4.5-4.5L9 18" />
                    </svg>
                  )}
                  {sub.icon === "video" && (
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M15 8a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-2.2l5 3.2V7l-5 3.2V8z" />
                    </svg>
                  )}
                </span>
                <span class="font-semibold group-hover/item:text-amber-600 transition-colors">
                  {sub.label}
                </span>
                {sub.sublabel && (
                  <span class="text-slate-500 font-normal text-[13px]">
                    {sub.sublabel}
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </nav>

  <div class="flex items-center gap-2.5">
    <a
      href={contactLink.href}
      class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-400 active:scale-95 text-white font-semibold text-sm px-5 md:px-6 py-2 rounded-full shadow-md transition-all"
    >
      {contactLink.label}
    </a>

    <button
      id="header-mobile-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="header-mobile-menu"
      aria-label="Buka menu navigasi"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-slate-700 text-slate-200 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="header-mobile-menu"
    class="hidden md:hidden absolute top-full left-0 right-0 bg-[#111e2e] border-t border-slate-800 shadow-xl px-6 py-4 space-y-1 z-50"
  >
    {mainLinks.map((item) => {
      const hasChildren = Boolean(item.children && item.children.length > 0);
      if (!hasChildren) {
        return (
          <a
            href={item.href}
            class="block py-2.5 text-sm font-semibold text-slate-200 hover:text-amber-400 transition-colors"
          >
            {item.label}
          </a>
        );
      }

      return (
        <details class="group">
          <summary class="flex items-center justify-between py-2.5 text-sm font-semibold text-slate-200 hover:text-amber-400 cursor-pointer list-none">
            <span>{item.label}</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="pl-4 pb-2 space-y-1 border-l border-amber-400/50 ml-1">
            {item.children!.map((sub) => (
              <a
                href={sub.href}
                class="block py-1.5 text-xs font-medium text-slate-300 hover:text-amber-400 transition-colors"
              >
                {sub.label}{sub.sublabel ? ` ${sub.sublabel}` : ""}
              </a>
            ))}
          </div>
        </details>
      );
    })}
  </div>
</header>

<script>
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-dropdown-trigger]"),
  );

  function closeAllDropdowns() {
    for (const btn of triggers) {
      const targetId = btn.dataset.dropdownTrigger;
      const panel = targetId ? document.getElementById(targetId) : null;
      const bar = btn.querySelector("[data-dropdown-bar]");
      const wasActiveRoute = btn.dataset.routeActive === "true";

      btn.setAttribute("aria-expanded", "false");
      panel?.classList.add("hidden");

      if (!wasActiveRoute) {
        btn.classList.remove("text-amber-400");
        btn.classList.add("text-slate-300");
        bar?.classList.remove("scale-x-100", "opacity-100");
        bar?.classList.add("scale-x-0", "opacity-0");
      }
    }
  }

  for (const btn of triggers) {
    if (btn.classList.contains("text-amber-400")) {
      btn.dataset.routeActive = "true";
    }

    btn.addEventListener("click", (event) => {
      event.stopPropagation();
      const targetId = btn.dataset.dropdownTrigger;
      const panel = targetId ? document.getElementById(targetId) : null;
      const bar = btn.querySelector("[data-dropdown-bar]");
      const isCurrentlyOpen = btn.getAttribute("aria-expanded") === "true";

      closeAllDropdowns();

      if (!isCurrentlyOpen && panel) {
        btn.setAttribute("aria-expanded", "true");
        panel.classList.remove("hidden");
        btn.classList.remove("text-slate-300");
        btn.classList.add("text-amber-400");
        bar?.classList.remove("scale-x-0", "opacity-0");
        bar?.classList.add("scale-x-100", "opacity-100");
      }
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest("[data-dropdown-container]")) {
      closeAllDropdowns();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeAllDropdowns();
    }
  });

  const mobileToggle = document.getElementById("header-mobile-toggle");
  const mobileMenu = document.getElementById("header-mobile-menu");

  mobileToggle?.addEventListener("click", () => {
    const expanded = mobileToggle.getAttribute("aria-expanded") === "true";
    mobileToggle.setAttribute("aria-expanded", String(!expanded));
    mobileMenu?.classList.toggle("hidden", expanded);
  });
</script>
