---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  brandName?: string;
  tagline?: string;
  navLinks?: NavItem[];
}

const {
  brandName = "PKBM",
  tagline = "Lorem ipsum",
  navLinks = [
    { label: "Beranda", href: "/" },
    { label: "Profile", href: "/profil" },
    { label: "Program", href: "/program" },
    { label: "Galeri", href: "/galeri" },
    { label: "Blog", href: "/blog" },
    { label: "Agenda", href: "/agenda" },
    { label: "Kontak", href: "/kontak" },
  ],
} = Astro.props;

const mainLinks = navLinks.filter((item) => item.label.toLowerCase() !== "kontak");
const contactLink = navLinks.find((item) => item.label.toLowerCase() === "kontak") ?? {
  label: "Kontak",
  href: "/kontak",
};

const currentPath = Astro.url.pathname;
---

<header class="bg-[#111e2e] text-white px-6 md:px-10 py-3.5 flex items-center justify-between shadow-md">
  <a href="/" class="flex items-center gap-3 group">
    <div class="w-10 h-10 rounded-xl bg-amber-400 flex items-center justify-center text-slate-900 shadow-md group-hover:scale-105 transition-transform">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path>
        <path d="M22 10v6"></path>
        <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
      </svg>
    </div>
    <div class="flex flex-col">
      <span class="font-bold text-white text-base leading-tight tracking-wide">
        {brandName}
      </span>
      <span class="text-xs text-slate-400">
        {tagline}
      </span>
    </div>
  </a>

  <nav class="hidden md:flex items-center gap-7">
    {mainLinks.map((item) => {
      const isActive =
        item.href === "/"
          ? currentPath === "/"
          : currentPath.startsWith(item.href);

      return (
        <a
          href={item.href}
          class:list={[
            "relative py-1 text-sm font-semibold transition-colors duration-200 group",
            isActive
              ? "text-amber-400"
              : "text-slate-300 hover:text-amber-400",
          ]}
        >
          <span>{item.label}</span>
          <span
            class:list={[
              "absolute -bottom-3 left-0 w-full h-[2.5px] bg-amber-400 rounded-full transition-all duration-300",
              isActive
                ? "scale-x-100 opacity-100"
                : "scale-x-0 opacity-0 group-hover:scale-x-100 group-hover:opacity-100",
            ]}
          ></span>
        </a>
      );
    })}
  </nav>

  <div>
    <a
      href={contactLink.href}
      class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-400 active:scale-95 text-white font-semibold text-sm px-6 py-2 rounded-full shadow-md transition-all"
    >
      {contactLink.label}
    </a>
  </div>
</header>
